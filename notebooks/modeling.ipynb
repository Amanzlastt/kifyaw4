   "source": [
    "from sklearn.preprocessing import OneHotEncoder\n",
    "def encode(train_df):\n",
    "  encoder = OneHotEncoder(handle_unknown = 'ignore')\n",
    "  data = train_df[['IsWeekday','IsWeekend']]\n",
    "  encoder.fit(data)\n",
    "  encoded = encoder.transform(data)\n",
    "  # Convert the encoded sparse matrix to a DataFrame\n",
    "  encoded_df = pd.DataFrame.sparse.from_spmatrix(encoded)\n",
    "\n",
    "  # Reset index to avoid potential conflicts during concatenation\n",
    "  # and give meaningful column names to the encoded features\n",
    "  encoded_df = encoded_df.reset_index(drop=True)\n",
    "  encoded_df.columns = encoder.get_feature_names_out(['IsWeekday','IsWeekend'])\n",
    "\n",
    "  # Concatenate the DataFrames\n",
    "  df_train = pd.concat([train_df.drop(['IsWeekday','IsWeekend'], axis=1).reset_index(drop=True), encoded_df], axis=1)\n",
    "\n",
    "  return df_train"
   ]
  },
